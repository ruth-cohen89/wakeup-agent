<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by AlarmKit. Without this the authorization request fails. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>WakeSpike schedules your morning alarms and the escalating follow-ups that keep going until you scan the code in your kitchen.</string>

	<!-- Required for the live-camera QR scanner. There is no photo-library path,
	     so no NSPhotoLibraryUsageDescription is needed or wanted. -->
	<key>NSCameraUsageDescription</key>
	<string>WakeSpike uses the camera to scan the QR code in your kitchen, which is how it confirms you actually got out of bed.</string>

	<!-- Fallback launch route into the wake flow if the App Intent path does not
	     behave as expected on device. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wakespike.verify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wake-agent</string>
			</array>
		</dict>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
